<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>b601_safety</name>
  <version>1.1.3</version>
  <description>
    B601 独立安全监控节点：订阅 /joint_states，发布 NORMAL/WARNING/EMERGENCY_STOP
    三档状态；只有角度或角速度越限才触发急停，急停时停控制器并把硬件置为 INACTIVE（全臂失能）。
  </description>
  <maintainer email="dave@example.com">dave</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>b601_description</exec_depend>
</package>
