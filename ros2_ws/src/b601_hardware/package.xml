<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>b601_hardware</name>
  <version>1.1.3</version>
  <description>
    B601-DM 的真机硬件接口：ros2_control SystemInterface 插件 DmSystemHardware，
    通过厂商 motor_abi 动态库驱动达妙 J4340P/J4310 电机（USB-CAN 串口桥）。
  </description>
  <maintainer email="dave@example.com">dave</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>b601_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
