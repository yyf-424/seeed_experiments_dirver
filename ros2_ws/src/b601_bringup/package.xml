<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>b601_bringup</name>
  <version>1.1.2</version>
  <description>
    B601 的启动包：把 robot_description、ros2_control、controller 依次拉起来。
    所有“后端差异”（mock / 真机 / MuJoCo）都收敛到一个 hardware 参数里。
  </description>
  <maintainer email="dave@example.com">dave</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>b601_description</exec_depend>
  <exec_depend>b601_demos</exec_depend>
  <exec_depend>b601_safety</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
